<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/appBg"
    android:fillViewport="true"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="16dp"
    android:paddingBottom="24dp"
    android:clipToPadding="false"
    tools:context=".ConfirmTicksActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:clipChildren="false"
        android:clipToPadding="false">

    <!-- Shared header: brand row + per-player score row + round title + progress bar -->
    <include
        layout="@layout/include_round_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <!-- Top/bottom weighted spacers center the row group (comfortably airier) -->
    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:minHeight="16dp" />

    <!-- Player 1 row -->
    <LinearLayout
        android:id="@+id/player1_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_card"
        android:elevation="@dimen/card_elevation"
        android:outlineAmbientShadowColor="@color/card_shadow"
        android:outlineSpotShadowColor="@color/card_shadow"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/player1_name_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.Spades.PlayerName"
                tools:text="Anna" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/player1_amount_of_tricks_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.Spades.Body"
                    android:textColor="?attr/appAccent"
                    tools:text="3 Tricks" />

                <TextView
                    android:id="@+id/player1_points_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.Spades.Body"
                    android:textColor="?attr/appMuted"
                    tools:text=" · +8 Points" />

            </LinearLayout>

        </LinearLayout>

        <TextView
            android:id="@+id/player1_check"
            android:layout_width="27dp"
            android:layout_height="27dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_check"
            android:gravity="center"
            android:textColor="?attr/appOnAccent"
            android:textSize="15sp"
            android:textStyle="bold"
            tools:text="✓" />

    </LinearLayout>

    <!-- Player 2 row -->
    <LinearLayout
        android:id="@+id/player2_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_card"
        android:elevation="@dimen/card_elevation"
        android:outlineAmbientShadowColor="@color/card_shadow"
        android:outlineSpotShadowColor="@color/card_shadow"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/player2_name_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.Spades.PlayerName"
                tools:text="Ben" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/player2_amount_of_tricks_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.Spades.Body"
                    android:textColor="?attr/appAccent"
                    tools:text="2 Tricks" />

                <TextView
                    android:id="@+id/player2_points_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.Spades.Body"
                    android:textColor="?attr/appMuted"
                    tools:text=" · +7 Points" />

            </LinearLayout>

        </LinearLayout>

        <TextView
            android:id="@+id/player2_check"
            android:layout_width="27dp"
            android:layout_height="27dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_check"
            android:gravity="center"
            android:textColor="?attr/appOnAccent"
            android:textSize="15sp"
            android:textStyle="bold"
            tools:text="✓" />

    </LinearLayout>

    <!-- Player 3 row -->
    <LinearLayout
        android:id="@+id/player3_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_card"
        android:elevation="@dimen/card_elevation"
        android:outlineAmbientShadowColor="@color/card_shadow"
        android:outlineSpotShadowColor="@color/card_shadow"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/player3_name_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.Spades.PlayerName"
                tools:text="Clara" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/player3_amount_of_tricks_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.Spades.Body"
                    android:textColor="?attr/appAccent"
                    tools:text="0 Tricks" />

                <TextView
                    android:id="@+id/player3_points_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.Spades.Body"
                    android:textColor="?attr/appMuted"
                    tools:text=" · +5 Points" />

            </LinearLayout>

        </LinearLayout>

        <TextView
            android:id="@+id/player3_check"
            android:layout_width="27dp"
            android:layout_height="27dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_check"
            android:gravity="center"
            android:textColor="?attr/appOnAccent"
            android:textSize="15sp"
            android:textStyle="bold"
            tools:text="✓" />

    </LinearLayout>

    <!-- Player 4 row (hidden in 3-player mode) -->
    <LinearLayout
        android:id="@+id/player4_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_card"
        android:elevation="@dimen/card_elevation"
        android:outlineAmbientShadowColor="@color/card_shadow"
        android:outlineSpotShadowColor="@color/card_shadow"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/player4_name_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.Spades.PlayerName"
                tools:text="David" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/player4_amount_of_tricks_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.Spades.Body"
                    android:textColor="?attr/appAccent"
                    tools:text="1 Trick" />

                <TextView
                    android:id="@+id/player4_points_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.Spades.Body"
                    android:textColor="?attr/appMuted"
                    tools:text=" · +6 Points" />

            </LinearLayout>

        </LinearLayout>

        <TextView
            android:id="@+id/player4_check"
            android:layout_width="27dp"
            android:layout_height="27dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_check"
            android:gravity="center"
            android:textColor="?attr/appOnAccent"
            android:textSize="15sp"
            android:textStyle="bold"
            tools:text="✓" />

    </LinearLayout>

    <!-- Warn subtitle: shown when every visible player is marked as a hit -->
    <TextView
        android:id="@+id/warn_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:textAppearance="@style/TextAppearance.Spades.Body"
        android:textColor="?attr/appWarn"
        android:visibility="invisible"
        tools:text="At least one player must miss" />

    <!-- Flex spacer pushes CTA to bottom -->
    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:minHeight="16dp" />

    <!-- CTA button -->
    <Button
        android:id="@+id/start_Button"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="@drawable/bg_cta"
        android:fontFamily="@font/space_grotesk_semibold"
        android:text="@string/next_round"
        android:textAllCaps="false"
        android:textColor="?attr/appCtaFg"
        android:textSize="16sp"
        app:backgroundTint="@null" />

    </LinearLayout>

</ScrollView>
