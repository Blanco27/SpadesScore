<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="?attr/appBg"
    tools:context=".DealCardsActivity">

    <!-- Shared header: brand row + per-player score row + round title + progress bar -->
    <include
        layout="@layout/include_round_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <!-- Dealer subtitle: e.g. "Anna deals" / "Anna teilt aus" -->
    <TextView
        android:id="@+id/dealer_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:textAppearance="@style/TextAppearance.Spades.Body"
        tools:text="Anna deals" />

    <!-- Top spacer -->
    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Deal illustration: card fan + card count + label (all centered) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center">

        <ImageView
            android:layout_width="160dp"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:src="@drawable/ic_card_fan"
            android:contentDescription="@string/image_of_playing_cards" />

        <!-- Number + "cards per player" label, baseline-aligned side by side -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="true"
            android:layout_marginTop="10dp">

            <TextView
                android:id="@+id/card_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.Spades.Number"
                android:textSize="40sp"
                android:textColor="?attr/appAccent"
                tools:text="5" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="7dp"
                android:layout_gravity="bottom"
                android:text="@string/cards_per_player"
                android:textAppearance="@style/TextAppearance.Spades.Body" />

        </LinearLayout>

    </LinearLayout>

    <!-- Bottom spacer -->
    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- CTA button -->
    <Button
        android:id="@+id/deal_next_button"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@drawable/bg_cta"
        android:text="@string/continue_label"
        android:textColor="?attr/appCtaFg"
        android:fontFamily="@font/space_grotesk_semibold"
        android:textAllCaps="false"
        android:textSize="15sp"
        app:backgroundTint="@null" />

</LinearLayout>
