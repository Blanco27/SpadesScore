<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/appBg"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="16dp"
    android:paddingBottom="24dp"
    tools:context=".MainActivity">

    <!-- Top bar: gear icon aligned to end -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end">

        <ImageButton
            android:id="@+id/settings_gear"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_gear"
            android:src="@drawable/ic_gear"
            app:tint="?attr/appMuted"
            android:padding="10dp"
            android:contentDescription="@string/settings_title" />

    </LinearLayout>

    <!-- Spacer (flex) -->
    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Hero: spade icon + wordmark + tagline (centred) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <ImageView
            android:layout_width="62dp"
            android:layout_height="62dp"
            android:src="@drawable/ic_spade"
            app:tint="?attr/appSpade"
            android:contentDescription="@null" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/wordmark"
            android:textAppearance="@style/TextAppearance.Spades.Wordmark"
            android:layout_marginTop="9dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/tagline"
            android:textAppearance="@style/TextAppearance.Spades.Body"
            android:layout_marginTop="5dp" />

    </LinearLayout>

    <!-- Spacer (flex) -->
    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Label: number of players -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/number_of_players"
        android:textAppearance="@style/TextAppearance.Spades.Label"
        android:layout_marginStart="4dp"
        android:layout_marginBottom="7dp" />

    <!-- Segment: 3 players / 4 players -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@drawable/bg_segment"
        android:padding="4dp">

        <TextView
            android:id="@+id/btn3Players"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/three"
            android:fontFamily="@font/space_grotesk_semibold"
            android:textSize="14sp"
            android:gravity="center"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/btn4Players"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/four"
            android:fontFamily="@font/space_grotesk_semibold"
            android:textSize="14sp"
            android:gravity="center"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>

    <!-- Spacer (flex) -->
    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- CTA: start game -->
    <Button
        android:id="@+id/start_game_button"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@drawable/bg_cta"
        android:backgroundTint="@null"
        android:text="@string/next"
        android:textColor="?attr/appCtaFg"
        android:fontFamily="@font/space_grotesk_semibold"
        android:textSize="15sp"
        android:textAllCaps="false"
        app:backgroundTint="@null" />

</LinearLayout>
