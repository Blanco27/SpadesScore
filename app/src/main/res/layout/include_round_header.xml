<?xml version="1.0" encoding="utf-8"?>
<!--
  Shared round header for Deal / Declare / Confirm screens.
  Brand row (spade + wordmark + round-progress) + per-player score row +
  round title (number tinted accent in code) + progress bar.
  Bind via Activity.bindRoundHeader(...) in ui/RoundHeader.kt.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- Brand row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_spade"
            app:tint="?attr/appSpade"
            android:contentDescription="@null" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:fontFamily="@font/space_grotesk_bold"
            android:textSize="16sp"
            android:textColor="?attr/appInk"
            android:layout_marginStart="7dp" />

        <Space
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/round_progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Spades.Body" />

    </LinearLayout>

    <!-- Score row: up to 4 player columns -->
    <LinearLayout
        android:id="@+id/header_score_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="16dp">

        <LinearLayout
            android:id="@+id/score_col_1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/score_name_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_medium"
                android:textSize="11sp"
                android:textColor="?attr/appMuted" />

            <TextView
                android:id="@+id/score_value_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.Spades.Number"
                android:textSize="13sp"
                android:layout_marginTop="1dp" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/score_col_2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/score_name_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_medium"
                android:textSize="11sp"
                android:textColor="?attr/appMuted" />

            <TextView
                android:id="@+id/score_value_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.Spades.Number"
                android:textSize="13sp"
                android:layout_marginTop="1dp" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/score_col_3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/score_name_3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_medium"
                android:textSize="11sp"
                android:textColor="?attr/appMuted" />

            <TextView
                android:id="@+id/score_value_3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.Spades.Number"
                android:textSize="13sp"
                android:layout_marginTop="1dp" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/score_col_4"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/score_name_4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_medium"
                android:textSize="11sp"
                android:textColor="?attr/appMuted" />

            <TextView
                android:id="@+id/score_value_4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.Spades.Number"
                android:textSize="13sp"
                android:layout_marginTop="1dp" />

        </LinearLayout>

    </LinearLayout>

    <!-- Round title (number tinted accent in code) -->
    <TextView
        android:id="@+id/round_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textAppearance="@style/TextAppearance.Spades.Title"
        android:layout_marginTop="22dp" />

    <!-- Progress bar -->
    <ProgressBar
        android:id="@+id/round_progress_bar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:progressDrawable="@drawable/progress_track"
        android:layout_marginTop="12dp" />

</LinearLayout>
