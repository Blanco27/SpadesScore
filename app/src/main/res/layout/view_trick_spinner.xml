<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_step"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingTop="6dp"
    android:paddingBottom="6dp"
    android:paddingStart="13dp"
    android:paddingEnd="13dp">

    <TextView
        android:id="@+id/btnMinus"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:layout_marginEnd="11dp"
        android:background="@null"
        android:fontFamily="@font/space_grotesk_semibold"
        android:gravity="center"
        android:minWidth="28dp"
        android:text="@string/minus"
        android:textColor="?attr/appMuted"
        android:textSize="17sp" />

    <TextView
        android:id="@+id/tvValue"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:layout_marginEnd="11dp"
        android:gravity="center"
        android:minWidth="24dp"
        android:text="@string/_0"
        android:textAppearance="@style/TextAppearance.Spades.Number"
        android:textColor="?attr/appAccent"
        android:textSize="18sp" />

    <TextView
        android:id="@+id/btnPlus"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:background="@null"
        android:fontFamily="@font/space_grotesk_semibold"
        android:gravity="center"
        android:minWidth="28dp"
        android:text="@string/plus"
        android:textColor="?attr/appMuted"
        android:textSize="17sp" />

</LinearLayout>
