<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/appBg"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="16dp"
    android:paddingBottom="24dp"
    tools:context=".PlayerNamesActivity">

    <!-- Screen title -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/set_player_names"
        android:textAppearance="@style/TextAppearance.Spades.ScreenTitle"
        android:textSize="26sp"
        android:layout_marginBottom="18dp" />

    <!-- Player 1 field card -->
    <LinearLayout
        android:id="@+id/player1_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_field"
        android:elevation="@dimen/card_elevation"
        android:outlineAmbientShadowColor="@color/card_shadow"
        android:outlineSpotShadowColor="@color/card_shadow"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:layout_marginBottom="14dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/player1_name"
            android:textAppearance="@style/TextAppearance.Spades.Label"
            android:layout_marginBottom="2dp" />

        <EditText
            android:id="@+id/player1_name_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/space_grotesk_medium"
            android:textSize="16sp"
            android:textColor="?attr/appInk"
            android:textColorHint="?attr/appMuted"
            android:background="@null"
            android:inputType="textPersonName"
            android:maxLines="1"
            android:imeOptions="actionNext"
            android:paddingTop="2dp"
            android:paddingBottom="2dp" />
    </LinearLayout>

    <!-- Player 2 field card -->
    <LinearLayout
        android:id="@+id/player2_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_field"
        android:elevation="@dimen/card_elevation"
        android:outlineAmbientShadowColor="@color/card_shadow"
        android:outlineSpotShadowColor="@color/card_shadow"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:layout_marginBottom="14dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/player2_name"
            android:textAppearance="@style/TextAppearance.Spades.Label"
            android:layout_marginBottom="2dp" />

        <EditText
            android:id="@+id/player2_name_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/space_grotesk_medium"
            android:textSize="16sp"
            android:textColor="?attr/appInk"
            android:textColorHint="?attr/appMuted"
            android:background="@null"
            android:inputType="textPersonName"
            android:maxLines="1"
            android:imeOptions="actionNext"
            android:paddingTop="2dp"
            android:paddingBottom="2dp" />
    </LinearLayout>

    <!-- Player 3 field card -->
    <LinearLayout
        android:id="@+id/player3_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_field"
        android:elevation="@dimen/card_elevation"
        android:outlineAmbientShadowColor="@color/card_shadow"
        android:outlineSpotShadowColor="@color/card_shadow"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:layout_marginBottom="14dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/player3_name"
            android:textAppearance="@style/TextAppearance.Spades.Label"
            android:layout_marginBottom="2dp" />

        <EditText
            android:id="@+id/player3_name_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/space_grotesk_medium"
            android:textSize="16sp"
            android:textColor="?attr/appInk"
            android:textColorHint="?attr/appMuted"
            android:background="@null"
            android:inputType="textPersonName"
            android:maxLines="1"
            android:imeOptions="actionNext"
            android:paddingTop="2dp"
            android:paddingBottom="2dp" />
    </LinearLayout>

    <!-- Player 4 field card (hidden in 3-player mode) -->
    <LinearLayout
        android:id="@+id/player4_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_field"
        android:elevation="@dimen/card_elevation"
        android:outlineAmbientShadowColor="@color/card_shadow"
        android:outlineSpotShadowColor="@color/card_shadow"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:layout_marginBottom="14dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/player4_name"
            android:textAppearance="@style/TextAppearance.Spades.Label"
            android:layout_marginBottom="2dp" />

        <EditText
            android:id="@+id/player4_name_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/space_grotesk_medium"
            android:textSize="16sp"
            android:textColor="?attr/appInk"
            android:textColorHint="?attr/appMuted"
            android:background="@null"
            android:inputType="textPersonName"
            android:maxLines="1"
            android:imeOptions="actionDone"
            android:paddingTop="2dp"
            android:paddingBottom="2dp" />
    </LinearLayout>

    <!-- Random dealer switch row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/random_first_dealer"
            android:fontFamily="@font/space_grotesk_medium"
            android:textSize="14.5sp"
            android:textColor="?attr/appInk" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/random_dealer_checkBox"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:thumb="@drawable/switch_thumb"
            app:track="@drawable/switch_track"
            app:thumbTint="@null"
            app:trackTint="@null"
            app:useMaterialThemeColors="false" />

    </LinearLayout>

    <!-- Flexible spacer — pushes CTA to the bottom -->
    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- CTA -->
    <Button
        android:id="@+id/start_game_button"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="@drawable/bg_cta"
        android:backgroundTint="@null"
        android:text="@string/next"
        android:textColor="?attr/appCtaFg"
        android:fontFamily="@font/space_grotesk_semibold"
        android:textSize="16sp"
        android:textAllCaps="false"
        app:backgroundTint="@null" />

</LinearLayout>
