<?xml version="1.0" encoding="utf-8"?>
<!--
  Declare-Tricks screen (Task 17 reskin).
  Structure: shared round header → subtitle → per-player card rows (spinner wired in code)
             → sum chip → warn subtitle (gone by default) → flex spacer → CTA.
  Lock logic (chip warn, warn subtitle, disabled CTA) is driven entirely in
  DeclareTricksActivity.updateCombinedTricksTextView().
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/appBg"
    android:fillViewport="true"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="64dp"
    android:paddingBottom="24dp"
    android:clipToPadding="false"
    tools:context=".DeclareTricksActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Shared round header: brand row + per-player score row + accent round title + progress bar -->
        <include layout="@layout/include_round_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <!-- Screen subtitle: "Call tricks" / "Stiche ansagen" -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/declare_tricks_subtitle"
            android:textAppearance="@style/TextAppearance.Spades.Body"
            android:gravity="center"
            android:layout_marginTop="14dp" />

        <!-- Small gap between subtitle and player rows -->
        <Space
            android:layout_width="match_parent"
            android:layout_height="4dp" />

        <!-- ── Player 1 card row ── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="15dp"
            android:paddingEnd="11dp"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            android:layout_marginTop="10dp">

            <TextView
                android:id="@+id/player1_name_text_view"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textAppearance="@style/TextAppearance.Spades.PlayerName"
                tools:text="Anna" />

            <com.nwe.spadesscore.TrickSpinner
                android:id="@+id/spinner1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

        </LinearLayout>

        <!-- ── Player 2 card row ── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="15dp"
            android:paddingEnd="11dp"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            android:layout_marginTop="10dp">

            <TextView
                android:id="@+id/player2_name_text_view"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textAppearance="@style/TextAppearance.Spades.PlayerName"
                tools:text="Ben" />

            <com.nwe.spadesscore.TrickSpinner
                android:id="@+id/spinner2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

        </LinearLayout>

        <!-- ── Player 3 card row ── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="15dp"
            android:paddingEnd="11dp"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            android:layout_marginTop="10dp">

            <TextView
                android:id="@+id/player3_name_text_view"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textAppearance="@style/TextAppearance.Spades.PlayerName"
                tools:text="Clara" />

            <com.nwe.spadesscore.TrickSpinner
                android:id="@+id/spinner3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

        </LinearLayout>

        <!-- ── Player 4 card row (hidden in 3-player mode) ── -->
        <LinearLayout
            android:id="@+id/player4_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="15dp"
            android:paddingEnd="11dp"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            android:layout_marginTop="10dp">

            <TextView
                android:id="@+id/player4_name_text_view"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textAppearance="@style/TextAppearance.Spades.PlayerName"
                tools:text="David" />

            <com.nwe.spadesscore.TrickSpinner
                android:id="@+id/spinner4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

        </LinearLayout>

        <!-- ── Sum chip: shows combined/cardAmount/tricks; bg+color driven by lock state ── -->
        <TextView
            android:id="@+id/sum_chip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_chip"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:fontFamily="@font/inter_semibold"
            android:textSize="12sp"
            android:textColor="?attr/appAccent"
            tools:text="6/5 Tricks" />

        <!-- ── Warn subtitle: shown when sum == cardAmount (locked state) ── -->
        <TextView
            android:id="@+id/warn_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:textAppearance="@style/TextAppearance.Spades.Body"
            android:textColor="?attr/appWarn"
            android:visibility="gone"
            tools:text="Sum must differ from 5" />

        <!-- Flexible spacer: pushes CTA to bottom when content fits; min 16dp when scrolling -->
        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="16dp" />

        <!-- ── CTA: id preserved for lock logic; bg/textColor driven by lock state ── -->
        <Button
            android:id="@+id/start_Button"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/bg_cta"
            android:backgroundTint="@null"
            android:fontFamily="@font/space_grotesk_semibold"
            android:text="@string/confirm_ticks"
            android:textAllCaps="false"
            android:textColor="?attr/appCtaFg"
            android:textSize="15sp"
            app:backgroundTint="@null" />

    </LinearLayout>

</ScrollView>
