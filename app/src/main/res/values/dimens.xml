    <!-- Stronger CTA drop-shadow (mockup .cta). Present in both themes (dark gets a
         gold glow via @color/cta_shadow); zeroed in code while a CTA is locked. -->
    <dimen name="cta_elevation">8dp</dimen>
</resources>
